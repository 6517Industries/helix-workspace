{
  "name": "@helix/web",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src --max-warnings=0",
    "preview": "vite preview --host 0.0.0.0",
    "audit:a11y": "node scripts/accessibility-audit.mjs",
    "audit:a11y:fallback": "node scripts/accessibility-audit.mjs --fallback-ok",
    "test": "vitest run --config vitest.config.ts --passWithNoTests --exclude='tests/e2e/**' --exclude='dist/**'",
    "test:e2e": "playwright test",
    "lint:e2e": "eslint tests/e2e --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e/tsconfig.json",
    "meet:media-probe": "node scripts/meet-media-probe.mjs",
    "test:e2e:meet-live": "playwright test --config playwright.meet-live.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.18",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@helix/contracts": "workspace:*",
    "@helix/sdk-web": "workspace:*",
    "@tanstack/pacer": "0.23.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.26",
    "@tanstack/store": "0.11.2",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hash-wasm": "4.13.0",
    "kdbxweb": "2.1.1",
    "livekit-client": "2.23.0",
    "lucide-react": "1.70.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@helix/config": "workspace:*",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-plugin": "1.169.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
